<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>it</string>
	<key>CFBundleExecutable</key><string>ScaboMac</string>
	<!-- Lo STESSO identificativo dell'app dell'iPad (LAYER2 § 12.16, decisione 15, 12 novembre 2026): il Mac sta nello stesso
	     record App Store, come acquisto universale, con build sue. Fino al 12 novembre era com.scabo.scabopdf.mac (l'officina di
	     prima): il contenitore della sandbox è cambiato con l'identificativo, e in quello vecchio non c'era la libreria vera (solo
	     materiale delle prove: nessun passaggio da fare, giro «ScaboPDF per Mac su TestFlight»). -->
	<key>CFBundleIdentifier</key><string>com.scabo.scabopdf</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<!-- L'app unica del Mac (LAYER2 § 12.16, decisioni 8-10): il nome del prodotto è ScaboPDF, come sull'iPad. -->
	<key>CFBundleName</key><string>ScaboPDF</string>
	<key>CFBundleDisplayName</key><string>ScaboPDF</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>0.1</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSMinimumSystemVersion</key><string>14.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSSupportsAutomaticTermination</key><false/>
	<key>NSSupportsSuddenTermination</key><false/>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<key>NSHumanReadableCopyright</key><string>ScaboPDF</string>
	<!-- I documenti che l'app importa da sé, come l'iPad: PDF e gli atti AKN di Normattiva (XML). «Apri con» e il trascinamento
	     sull'icona arrivano qui; un XML che non è un atto si rifiuta con la spiegazione in prosa. Il pacchetto .scabolettura si
	     aprirà dalla tappa D (DISEGNO_LETTURA_MAC § 6.3). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Documento PDF</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Atto normativo in XML</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>public.xml</string></array>
		</dict>
	</array>
	<!-- Il pacchetto della lettura (lo stesso tipo dichiarato dall'app per iPad, giro del 2026-10-16): lo produce il Mac. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.scabo.scabopdf.lettura</string>
			<key>UTTypeDescription</key><string>Lettura ScaboPDF</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>scabolettura</string></array>
				<key>public.mime-type</key>
				<array><string>application/x-scabopdf-lettura</string></array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- L'app: sandbox attiva e SOLO la lettura/scrittura dei file che l'utente sceglie (il PDF da elaborare, il
	     pacchetto da salvare per il cavo). NIENTE rete (giro «costruzione della linea Mac», 2026-10-16): i modelli girano
	     dentro l'app senza poter parlare con l'esterno. Lo scaricamento dei pesi passa dal servizio XPC
	     com.scabo.scabopdf.mac.scaricatore, l'unico pezzo con com.apple.security.network.client
	     (scripts/ScaboMacScaricatore.entitlements). -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node / React Native
node_modules/
.expo/
*.log

# React Native app (Layer 2) build/native artifacts are ignored by the
# app/.gitignore shipped with the RN scaffold (ios/build, ios/Pods, android
# build, .xcode.env.local, *.jsbundle, coverage, ...), which is correctly
# anchored to the app/ subtree. node_modules/ above already matches app/.

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local state (per-session scheduled tasks, etc.)
.claude/

# Project-specific
*.pdf
*.scabopdf.json
docs/analysis/private/
# Copyright-protected PDF samples for local testing only
pipeline/tests/fixtures/private/
.venv-exploration/

# On-device test-framework output derived from the private PDFs (extraction
# captures, full node/segment dumps, per-PDF reports). Copyright-encumbered like
# the fixtures; only content-free baseline reports are committed, deliberately.
test-output-private/

# Estratti scratch temporanei (documentazione allegabile, non parte del repo)
ultrafocus_extracts/

# Buste-frammento dell'officina ultrafocus (portano il testo dei volumi):
# non devono mai entrare in git, ovunque compaiano.
*.scabofrag.json

# Uscite di build dei pacchetti SwiftPM della linea Mac (app/macos/*, ramo feat/mac-base): restano nel working
# tree quando si cambia ramo e non devono mai entrare in un commit su main.
app/macos/**/build/
app/macos/**/.build/
app/macos/**/.swiftpm/
